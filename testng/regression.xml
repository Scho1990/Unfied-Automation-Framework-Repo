<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Regression Suite" parallel="methods" thread-count="5">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.DynamicParallelModeAndThreadCountListener"/>
    </listeners>

    <test name="Regression">
        <classes>
            <class name="testscripts.ERailTest"/>
            <class name="testscripts.ERail2Test"/>
            <class name="testscripts.ERail3Test"/>
            <class name="testscripts.ERail4Test"/>
            <class name="testscripts.ERail5Test"/>
            <class name="testscripts.ERail6Test"/>
            <class name="testscripts.GoogleSearchResultTest"/>
        </classes>
    </test>

</suite>
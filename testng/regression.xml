<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Regression Suite" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.DynamicParallelModeAndThreadCountListener"/>
        <listener class-name="retry.RetryTransformer"/>
    </listeners>

    <test name="Regression">
        <classes>
            <class name="tests.ERailTest"/>
            <class name="tests.ERail2Test"/>
            <class name="tests.ERail3Test"/>
            <class name="tests.ERail4Test"/>
            <class name="tests.ERail5Test"/>
            <class name="tests.ERail6Test"/>
            <class name="tests.GoogleSearchResultTest"/>
            <class name="tests.ShadowRootResultTest"/>
            <class name="tests.spotify.playlist.PlaylistApiTest"/>
        </classes>
    </test>

</suite>
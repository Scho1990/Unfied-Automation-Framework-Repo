<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Smoke Suite" parallel="methods" thread-count="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.DynamicParallelModeAndThreadCountListener"/>
    </listeners>

    <test name="Smoke">
        <classes>
            <class name="tests.ERailTest"/>
            <class name="tests.OrangeHRMLoginTest"/>
            <class name="tests.GoogleSearchResultTest"/>
        </classes>
    </test>

</suite>